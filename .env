APP_ENV=prod
APP_DEBUG=1

DATABASE_USER=pimcore
DATABASE_PASSWORD=pimcore
DATABASE_NAME=pimcore
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_VERSION=8.0.26
# Pimcore 2026 configures the default connection via DATABASE_URL; built from the parts above
DATABASE_URL="mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?serverVersion=${DATABASE_VERSION}"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

# Pimcore registration and encryption: set real values in .env.local / the deployment secret
PIMCORE_ENCRYPTION_SECRET=
PIMCORE_INSTANCE_IDENTIFIER=
PIMCORE_PRODUCT_KEY=
