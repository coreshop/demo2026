{
  "name": "pimcore/skeleton",
    "description": "CoreShop 2026 demo shop on Pimcore 2026",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.4.13"
    }
  },
  "require": {
    "coreshop/core-shop": "^2026.2",
    "pimcore/pimcore": "^2026.2",
    "pimcore/quill-bundle": "^2026.1",
    "pimcore/studio-backend-bundle": "^2026.2",
    "pimcore/studio-ui-bundle": "^2026.2",
    "rybakit/twig-deferred-extension": "^3.0",
    "symfony/runtime": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Pimcore\\Model\\DataObject\\": "var/classes/DataObject"
    },
    "classmap": [
      "src/Kernel.php"
    ]
  },
  "repositories": {
  },
  "scripts": {
    "post-create-project-cmd": "Pimcore\\Composer::postCreateProject",
    "post-install-cmd": [
      "Pimcore\\Composer::postInstall",
      "@pimcore-scripts"
    ],
    "post-update-cmd": [
      "Pimcore\\Composer::postUpdate",
      "@pimcore-scripts",
      "Pimcore\\Composer::executeMigrationsUp",
      "@pimcore-scripts"
    ],
    "pimcore-scripts": [
      "Pimcore\\Composer::clearCache",
      "Pimcore\\Composer::installAssets"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "phpstan/phpstan": "^2.1"
  }
}
